# ==============================================================================
# نظام إدارة محافظ الشركاء في البورصة - مركز الشاطبي
# إعدادات الاتصال بقاعدة بيانات Supabase (PostgreSQL)
# ==============================================================================

# 1. رابط مشروع Supabase الخاص بك (من Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. المفتاح العام المجهول (من Settings -> API -> anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 3. المفتاح السري المتقدم (اختياري - من Settings -> API -> service_role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# المنفذ
PORT=3000
